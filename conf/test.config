/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run sage/dcqc -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test TXT profile'
    config_profile_description = 'Small test dataset to check pipeline function'

    // Shown in the parameter summary. Keep these the same as process.resourceLimits below.
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    // Input data
    input = "${projectDir}/testdata/input_txt.csv"
    required_tests = "LibTiffInfoTest,BioFormatsInfoTest,OmeXmlSchemaTest"

}

// Limit resources so that this can run on GitHub Actions.
// Set directly, because conf/base.config reads params.max_* before this profile is applied.
// Keep these the same as the max_* params above.
process {
    resourceLimits = [
        cpus  : 2,
        memory: '6.GB',
        time  : '6.h'
    ]
}
