{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/sage/dcqc/master/assets/schema_input.json",
    "title": "sage/dcqc pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "url": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "File URL must be provided and cannot contain spaces"
            },
            "file_type": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "File type cannot contain spaces"
            },
            "md5_checksum": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "MD5 checksum cannot contain spaces"
            }
        },
        "required": ["url"]
    }
}
